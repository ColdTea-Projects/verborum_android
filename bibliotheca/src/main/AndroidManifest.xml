<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required by SyncScheduler.syncOnReconnect()'s ConnectivityManager.registerNetworkCallback.
      Declared here (not only in :app) so this module is self-contained — manifest merging unions
      it into any consumer, and lint analyses each module in isolation.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
