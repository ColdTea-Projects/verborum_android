<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required by rememberIsOnline()'s ConnectivityManager.registerNetworkCallback. Declared here
      rather than only in :app so this module is self-contained — manifest merging unions it into
      any consumer, and lint analyses each module in isolation.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!--
          Silent data pushes only (SYNC / REFRESH) — nothing is displayed, so no notification permission
          or channel is involved. Not exported: only the FCM client library binds to it.
        -->
        <service
            android:name=".push.messaging.VerborumMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
