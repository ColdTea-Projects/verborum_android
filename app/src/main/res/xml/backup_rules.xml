<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 30 and below (android:fullBackupContent).
   API 31+ uses data_extraction_rules.xml — keep the two in sync.
-->
<full-backup-content>
    <!--
       The auth prefs are EncryptedSharedPreferences: the values *and* the Tink keyset live in this
       file, but the master key lives in the Android Keystore, which is device-bound and never
       backed up. Restoring the file onto another device (or after a reinstall) therefore yields
       ciphertext nothing can decrypt. Excluding it means a restored install simply starts signed
       out, which is the correct outcome for a credential store — see AuthTokenStore.
    -->
    <exclude domain="sharedpref" path="verborum_auth_prefs.xml" />
</full-backup-content>
